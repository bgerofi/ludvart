#!/usr/bin/env python3
import sys, os, base64, argparse, subprocess, re, fnmatch, difflib, py_compile, json

VER = "0.4.5"
CAPS = "read,write,append,replace,replace-range,structured-patch,search,run,info,spec"

# The authoritative interface reference. ludvart folds this verbatim into the
# model's system prompt (read straight from this file, never executed), so the
# instructions and the code can only ever ship together. Keep it ASCII, keep
# every example on the helper's full path, and update it in the same edit as any
# behaviour change here.
SPEC = """\
Path: ~/.ludvart/bin/ludvart_helper  -- an executable that is NOT on PATH.
Invoking it by bare name fails with "command not found"; always spell out the
full path, exactly as every example below does. Requires only python3 (3.6+)
and the standard library.

Why to prefer it over typing shell commands: content is passed as base64, so
quoting, newlines, backslashes and escapes cannot corrupt it, and every result
carries an explicit exit code instead of having to be guessed from screen text.

Result framing:
    <<<LUDVART:BEGIN op=NAME>>>
    <one line of base64; present only when the op returns data>
    <<<LUDVART:END op=NAME exit=CODE key=value ...>>>
Base64-decode the line between BEGIN and END to get the payload. Decide success
or failure from exit= alone. The one exception is op=usage (exit=7), whose
payload is plain text spanning several lines -- see the exit codes below.

Every subcommand ends with that END sentinel, run included -- run is only the
exception to the BEGIN half, because its command writes straight to the terminal
instead of returning a payload. So the real exit status of anything the helper
runs is always there on screen: read exit= rather than judging the outcome from
what the output looks like.

Exit codes:
    0  success
    1  search only: no matches
    2  replace / structured-patch: the old text was not found; file unchanged
    3  replace / structured-patch: --expect-count did not match; file unchanged
    4  a .py file was written but no longer compiles; meta has error=py_syntax
       and backup=PATH.ludvart.bak (the pre-edit contents)
    5  structured-patch: the payload is not valid JSON
    6  structured-patch: the edits list is missing or malformed
    7  the call itself was wrong -- a missing, unknown or misspelled argument.
       Nothing ran and nothing was written. The frame is op=usage and its
       payload is the error followed by the section below for the subcommand
       that was attempted, so the call can be corrected and retried at once.
       That one payload is plain text rather than base64, precisely so the
       correction can be read where it lands instead of having to be decoded.

Any write first copies the target to PATH.ludvart.bak, and a written .py file is
compile-checked (meta pycheck=ok or pycheck=FAILED).

Size limit: the helper is reached by typing a command line into the terminal,
and that channel carries only about 2 KB per call -- a longer one is liable to
arrive empty or cut short, which the shell will then run as something other than
what was meant. So no single call may carry more than ~2 KB of base64. Content
bigger than that is built up instead: one write with the first chunk, then an
append per remaining chunk. To change part of a large file, use replace,
replace-range or structured-patch rather than rewriting the whole of it.

Subcommands
-----------
At a glance -- the path comes first everywhere except search, which takes the
pattern first and names its path with --path:
    read              PATH     [--start N] [--end M]
    write             PATH     --b64 DATA
    append            PATH     --b64 DATA
    replace           PATH     --old-b64 A --new-b64 B [--expect-count K]
    replace-range     PATH     --start N --end M --b64 DATA
    structured-patch  PATH     --b64 JSON
    search            PATTERN  [--path P] [--glob G]
    run                        --b64 CMD
    info / spec                (no arguments)

read PATH [--start N] [--end M]
    Payload is the file, or the 1-indexed inclusive line range N..M.
    Meta: path=, lines=<total in file>, range=<A-B or all>.
    ~/.ludvart/bin/ludvart_helper read src/app.py --start 40 --end 80

write PATH --b64 DATA [--dry-run]
    Overwrite PATH with the decoded DATA, creating parent directories.
    Meta: path=, bytes=. With --dry-run nothing is written and the payload is
    a unified diff of the change instead.
    Keep DATA under ~2 KB; for more, write the first chunk and append the rest.
    ~/.ludvart/bin/ludvart_helper write notes.txt --b64 aGVsbG8K

append PATH --b64 DATA
    Append the decoded DATA to PATH, creating it if absent. Meta: path=, bytes=.
    This is how a file larger than one call is written: repeat it per chunk, and
    check bytes= against what was sent so a short chunk is caught at once.

replace PATH --old-b64 A --new-b64 B [--count N] [--expect-count K] [--dry-run]
    Literal (never regex) replacement of A with B. Replaces every occurrence
    unless --count limits it. --expect-count K refuses to write unless A occurs
    exactly K times, which is the safe way to edit a single known site.
    Meta on success: path=, replaced=<n>.
    ~/.ludvart/bin/ludvart_helper replace src/app.py --old-b64 T0xE --new-b64 TkVX --expect-count 1

replace-range PATH --start N --end M --b64 DATA [--dry-run]
    Replace lines N..M (1-indexed, inclusive) with the decoded DATA. Use it when
    the old text is awkward to reproduce exactly. Meta: range=N-M.

structured-patch PATH --b64 JSON [--dry-run]
    Apply several exact edits in one pass, writing only if all of them apply.
    The decoded JSON is:
        {"edits": [{"old_b64": "...", "new_b64": "...", "expect_count": 1}]}
    expect_count defaults to 1 per edit; set it to null to accept any number.
    An optional "count" caps how many occurrences that edit replaces. On failure
    the meta names the failing edit with index=<1-based>.
    Meta on success: edits=<n>, replaced=<total>.

search PATTERN [--path P] [--glob G]
    Recursive Python-regex search. P defaults to "." and may be a file or a
    directory; --glob filters file names, e.g. "*.py". Skips .git, node_modules
    and __pycache__. Payload is newline-joined "path:lineno:text" hits.
    The pattern may equally be given as --pattern PATTERN, and grep's -n is
    accepted and ignored, since every hit already carries its line number.
    Given two bare arguments, whichever one names something that exists is
    taken as the path and the other as the pattern, so "search FILE REGEX"
    works as well as "search REGEX FILE". When both or neither exist there is
    nothing to go on: say which is which with --pattern and --path.
    exit=0 when there was at least one hit, exit=1 when there was none.
    Meta: matches=.
    ~/.ludvart/bin/ludvart_helper search "def main" --path src --glob "*.py"

run --b64 CMD
    Run the decoded CMD through the shell with its stdout and stderr going
    straight to the terminal, then print only the END sentinel. exit= on that
    sentinel is the command's real status, propagated from the child process
    (for a pipeline, that of the last command). It is the answer to "did this
    work?" -- a compiler, a test run or a linter that printed nothing alarming
    still failed if exit= is non-zero.
    ~/.ludvart/bin/ludvart_helper run --b64 bWFrZSB0ZXN0

info
    Payload is "ludvart_helper <version>", caps= and the python version. Use it
    to check the helper is installed and what it supports.

spec
    Payload is this reference. Re-read it with
    ~/.ludvart/bin/ludvart_helper spec
    if you ever need the interface and it is not already in front of you; every
    subcommand also accepts -h.\
"""

def _spec_section(name):
    if not name or name.startswith("-"):
        return ""
    body = SPEC.split("-----------\n", 1)[-1].split("\n")
    out = []
    for line in body:
        if out:
            if line and not line.startswith(" "):
                break
            out.append(line)
        elif line == name or line.startswith(name + " "):
            out.append(line)
    return "\n".join(out).rstrip()

def _usage_text(name, message):
    # The whole SPEC would be both unreadable on a terminal and unsafe to print
    # unencoded, since it quotes the sentinel itself. A subcommand section never
    # does, so name one when we can and otherwise just point at spec.
    section = _spec_section(name)
    if not section:
        section = ("subcommands: " + CAPS.replace(",", ", ") + "\n"
                   "~/.ludvart/bin/ludvart_helper spec  -- the full reference")
    return "error: " + message + "\n\n" + section

def emit(op, payload_bytes=None, code=0, **meta):
    payload = None
    if payload_bytes is not None:
        payload = base64.b64encode(payload_bytes).decode()
    return _frame(op, payload, code, meta)

def emit_plain(op, text, code=0, **meta):
    # Help is not data: base64 would hide the correction from the very reader
    # who needs it, on the screen and in the model's next snapshot alike. Only
    # for text this file wrote itself, which never contains the sentinel.
    return _frame(op, text, code, meta)

def _frame(op, payload, code, meta):
    sys.stdout.write("<<<LUDVART:BEGIN op=%s>>>\n" % op)
    if payload is not None:
        sys.stdout.write(payload + "\n")
    metastr = "".join(" %s=%s" % (k, v) for k, v in meta.items())
    sys.stdout.write("<<<LUDVART:END op=%s exit=%d%s>>>\n" % (op, code, metastr))
    sys.stdout.flush()
    return code

def _backup(path):
    try:
        if os.path.isfile(path):
            with open(path, "rb") as f:
                data = f.read()
            with open(path + ".ludvart.bak", "wb") as f:
                f.write(data)
    except (IOError, OSError):
        pass

def _pycheck(path):
    if not path.endswith(".py"):
        return None
    try:
        py_compile.compile(path, doraise=True)
        return "ok"
    except py_compile.PyCompileError:
        return "FAILED"

def _save(op, path, ndata, dry, **meta):
    if dry:
        try:
            with open(path, "rb") as f:
                old = f.read()
        except (IOError, OSError):
            old = b""
        diff = "".join(difflib.unified_diff(
            old.decode("utf-8", "replace").splitlines(keepends=True),
            ndata.decode("utf-8", "replace").splitlines(keepends=True),
            fromfile=path, tofile=path + " (new)"))
        return emit(op, diff.encode(), 0, path=path, dry_run="1", **meta)
    _backup(path)
    with open(path, "wb") as f:
        f.write(ndata)
    pc = _pycheck(path)
    code = 0
    if pc is not None:
        meta["pycheck"] = pc
        if pc == "FAILED":
            code = 4
            meta["error"] = "py_syntax"
            meta["backup"] = path + ".ludvart.bak"
    return emit(op, None, code, path=path, **meta)

def op_read(a):
    with open(a.path, "rb") as f:
        data = f.read()
    lines = data.split(b"\n")
    total = len(lines)
    rng = "all"
    if a.start is not None or a.end is not None:
        s = (a.start or 1) - 1
        e = a.end if a.end is not None else total
        data = b"\n".join(lines[s:e])
        rng = "%d-%d" % (s + 1, e)
    return emit("read", data, 0, path=a.path, lines=total, range=rng)

def op_write(a):
    data = base64.b64decode(a.b64)
    d = os.path.dirname(a.path)
    if d:
        os.makedirs(d, exist_ok=True)
    return _save("write", a.path, data, a.dry_run, bytes=len(data))

def op_append(a):
    data = base64.b64decode(a.b64)
    d = os.path.dirname(a.path)
    if d:
        os.makedirs(d, exist_ok=True)
    with open(a.path, "ab") as f:
        f.write(data)
    return emit("append", None, 0, path=a.path, bytes=len(data))

def op_replace(a):
    old = base64.b64decode(a.old_b64)
    new = base64.b64decode(a.new_b64)
    with open(a.path, "rb") as f:
        data = f.read()
    found = data.count(old)
    if found == 0:
        return emit("replace", None, 2, path=a.path, error="old_not_found")
    if a.expect_count is not None and found != a.expect_count:
        return emit("replace", None, 3, path=a.path,
                    error="count_mismatch", found=found, expected=a.expect_count)
    cnt = -1 if a.count is None else a.count
    ndata = data.replace(old, new, cnt) if cnt >= 0 else data.replace(old, new)
    n = found if cnt < 0 else min(cnt, found)
    return _save("replace", a.path, ndata, a.dry_run, replaced=n)

def op_replace_range(a):
    new = base64.b64decode(a.b64)
    with open(a.path, "rb") as f:
        lines = f.read().split(b"\n")
    s = a.start - 1
    e = a.end
    ndata = b"\n".join(lines[:s] + new.split(b"\n") + lines[e:])
    return _save("replace-range", a.path, ndata, a.dry_run, range="%d-%d" % (a.start, a.end))

def op_structured_patch(a):
    try:
        spec = json.loads(base64.b64decode(a.b64).decode("utf-8"))
    except Exception:
        return emit("structured-patch", None, 5, path=a.path, error="bad_json")
    edits = spec.get("edits") if isinstance(spec, dict) else None
    if not isinstance(edits, list) or not edits:
        return emit("structured-patch", None, 6, path=a.path, error="no_edits")
    with open(a.path, "rb") as f:
        data = f.read()
    replaced_total = 0
    for i, edit in enumerate(edits, 1):
        if not isinstance(edit, dict):
            return emit("structured-patch", None, 6, path=a.path, error="bad_edit", index=i)
        old_b64 = edit.get("old_b64")
        new_b64 = edit.get("new_b64")
        if old_b64 is None or new_b64 is None:
            return emit("structured-patch", None, 6, path=a.path, error="bad_edit", index=i)
        try:
            old = base64.b64decode(old_b64)
            new = base64.b64decode(new_b64)
        except Exception:
            return emit("structured-patch", None, 6, path=a.path, error="bad_edit_b64", index=i)
        found = data.count(old)
        if found == 0:
            return emit("structured-patch", None, 2, path=a.path, error="old_not_found", index=i)
        expect = edit.get("expect_count", 1)
        if expect is not None and found != expect:
            return emit("structured-patch", None, 3, path=a.path,
                        error="count_mismatch", index=i, found=found, expected=expect)
        cnt = edit.get("count")
        if cnt is not None:
            if not isinstance(cnt, int) or cnt < 0:
                return emit("structured-patch", None, 6, path=a.path, error="bad_count", index=i)
            data = data.replace(old, new, cnt)
            replaced_total += min(found, cnt)
        else:
            data = data.replace(old, new)
            replaced_total += found
    return _save("structured-patch", a.path, data, a.dry_run,
                 edits=len(edits), replaced=replaced_total)

SKIP = {".git", "node_modules", "__pycache__"}

def _resolve_search(a):
    """Sort the bare arguments into a pattern and a path.

    Every other subcommand takes its path first, so writing search that way is
    the natural slip rather than a careless one. Both readings of "search A B"
    describe the same search whenever exactly one of A and B exists on disk, so
    working it out beats spending a round-trip refusing it. Returns
    (pattern, path) or (None, complaint).
    """
    words = list(a.words)
    path = a.path
    if a.pattern_flag is not None:
        if words:
            return None, "the pattern was given twice, positionally and as --pattern"
        pattern = a.pattern_flag
    elif not words:
        return None, "a pattern is required"
    elif len(words) == 1:
        pattern = words[0]
    elif len(words) == 2:
        if path is not None:
            return None, "the path was given twice, positionally and as --path"
        first, second = words
        if os.path.exists(first) == os.path.exists(second):
            return None, ("cannot tell which of %r and %r is the pattern:"
                          " name them with --pattern and --path" % (first, second))
        pattern, path = (second, first) if os.path.exists(first) else (first, second)
    else:
        return None, "too many arguments: a pattern containing spaces must be quoted"
    return pattern, ("." if path is None else path)

def op_search(a):
    pattern, path = _resolve_search(a)
    if pattern is None:
        return emit_plain("usage", _usage_text("search", path), 7,
                          error="bad_args", subcommand="search")
    rx = re.compile(pattern)
    hits = []
    root = path
    files = []
    if os.path.isfile(root):
        files = [root]
    else:
        for dp, dns, fns in os.walk(root):
            dns[:] = [d for d in dns if d not in SKIP]
            for fn in fns:
                if a.glob and not fnmatch.fnmatch(fn, a.glob):
                    continue
                files.append(os.path.join(dp, fn))
    for fp in files:
        try:
            with open(fp, "r", errors="replace") as f:
                for i, line in enumerate(f, 1):
                    if rx.search(line):
                        hits.append("%s:%d:%s" % (fp, i, line.rstrip("\n")))
        except (IOError, OSError):
            continue
    payload = "\n".join(hits).encode()
    return emit("search", payload, 0 if hits else 1, matches=len(hits))

def op_run(a):
    cmd = base64.b64decode(a.b64).decode()
    pr = subprocess.Popen(cmd, shell=True)
    code = pr.wait()
    sys.stdout.write("<<<LUDVART:END op=run exit=%d>>>\n" % code)
    sys.stdout.flush()
    return code

def op_info(a):
    txt = "ludvart_helper %s\ncaps=%s\npython=%s" % (VER, CAPS, sys.version.split()[0])
    return emit("info", txt.encode(), 0)

def op_spec(a):
    return emit("spec", SPEC.encode(), 0, version=VER)

class Parser(argparse.ArgumentParser):
    # argparse's own usage message is unframed and exits 2, which collides with
    # the helper's "old text not found". Answer with a normal frame carrying the
    # spec for the attempted subcommand so a wrong flag can be fixed in place.
    def error(self, message):
        name = self.prog.split()[-1]
        if name == "ludvart_helper":
            # An unknown flag is reported by the top-level parser, which knows
            # nothing of the subcommand the caller meant.
            name = (sys.argv[1:2] or [""])[0]
        emit_plain("usage", _usage_text(name, message), 7,
                   error="bad_args", subcommand=name or "none")
        sys.exit(7)

def main():
    p = Parser(prog="ludvart_helper")
    # NOTE: the required= keyword for subparsers needs Python 3.7+, so we leave
    # the subcommand optional here and enforce that one was chosen manually
    # below. This keeps the helper working on any Python 3.2+ (some hosts still
    # ship 3.6).
    sub = p.add_subparsers(dest="cmd")
    r = sub.add_parser("read"); r.add_argument("path"); r.add_argument("--start", type=int); r.add_argument("--end", type=int); r.set_defaults(fn=op_read)
    w = sub.add_parser("write"); w.add_argument("path"); w.add_argument("--b64", required=True); w.add_argument("--dry-run", action="store_true"); w.set_defaults(fn=op_write)
    ap = sub.add_parser("append"); ap.add_argument("path"); ap.add_argument("--b64", required=True); ap.set_defaults(fn=op_append)
    rp = sub.add_parser("replace"); rp.add_argument("path"); rp.add_argument("--old-b64", dest="old_b64", required=True); rp.add_argument("--new-b64", dest="new_b64", required=True); rp.add_argument("--count", type=int); rp.add_argument("--expect-count", dest="expect_count", type=int); rp.add_argument("--dry-run", action="store_true"); rp.set_defaults(fn=op_replace)
    rr = sub.add_parser("replace-range"); rr.add_argument("path"); rr.add_argument("--start", type=int, required=True); rr.add_argument("--end", type=int, required=True); rr.add_argument("--b64", required=True); rr.add_argument("--dry-run", action="store_true"); rr.set_defaults(fn=op_replace_range)
    sp = sub.add_parser("structured-patch"); sp.add_argument("path"); sp.add_argument("--b64", required=True); sp.add_argument("--dry-run", action="store_true"); sp.set_defaults(fn=op_structured_patch)
    s = sub.add_parser("search"); s.add_argument("words", nargs="*"); s.add_argument("--pattern", dest="pattern_flag"); s.add_argument("--path"); s.add_argument("--glob"); s.add_argument("-n", "--line-number", action="store_true"); s.set_defaults(fn=op_search)
    rn = sub.add_parser("run"); rn.add_argument("--b64", required=True); rn.set_defaults(fn=op_run)
    inf = sub.add_parser("info"); inf.set_defaults(fn=op_info)
    sc = sub.add_parser("spec"); sc.set_defaults(fn=op_spec)
    a = p.parse_args()
    if not getattr(a, "fn", None):
        p.error("a subcommand is required, one of: " + CAPS.replace(",", ", "))
    sys.exit(a.fn(a))

if __name__ == "__main__":
    main()
